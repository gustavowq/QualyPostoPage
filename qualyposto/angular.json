{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "qualyposto": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "tsConfig": "tsconfig.app.json",
            "outputMode": "static",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "optimization": {
              "scripts": true,
              "styles": true,
              "fonts": false
            },
            "outputHashing": "all",
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "600kB",
                "maximumError": "1MB"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "qualyposto:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "4997f972-2362-4438-9877-d2bf4915eeba"
  }
}